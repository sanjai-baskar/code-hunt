{
  "version": 2,
  "trailingSlash": false,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend,public}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
